# Copy to .env.local for local development. Never commit real secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Keep false until a real email/SMS provider is configured.
ENABLE_NOTIFICATIONS=false

# Optional: configure Resend for live transactional emails
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL="Divine Links <notifications@divinelinks.co>"
