# ==============================================================================
# Divine Links MVP — Production & Development Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development. Never commit real secrets.

# ------------------------------------------------------------------------------
# 1. Supabase Database & Authentication (REQUIRED)
# ------------------------------------------------------------------------------
# Project URL from Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anonymous key (used for client-side auth & token session recovery)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Privileged service role secret (SERVER-ONLY — NEVER expose to the browser)
# Used for server-side atomic RPC execution, admin queries, and audit events.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# 2. Notifications & Outbox Worker (OPTIONAL — defaults to simulated)
# ------------------------------------------------------------------------------
# Set to 'true' only when ready to dispatch real emails to customers and ops desk.
# When false or unset, notifications are recorded as 'simulated' without external calls.
ENABLE_NOTIFICATIONS=false

# Resend API key for transactional emails (starts with 're_...')
RESEND_API_KEY=

# Verified sender email address configured on Resend domain
NOTIFICATIONS_FROM_EMAIL="Divine Links <notifications@divinelinks.co>"

# Secret token used by cron jobs and webhooks to trigger /api/admin/outbox/process
# Header: 'x-cron-secret: <CRON_SECRET>' or 'Authorization: Bearer <CRON_SECRET>'
CRON_SECRET=

# ------------------------------------------------------------------------------
# 3. Distributed Rate Limiting & Proxy Security (OPTIONAL)
# ------------------------------------------------------------------------------
# Upstash / Redis REST API for distributed sliding-window rate limiting across instances.
# If omitted, the system falls back safely to in-memory sliding window cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Reverse proxy trust boundary: 'vercel' | 'cloudflare' | 'custom' | 'none'
# When set, prevents header spoofing by honoring only verified provider edge headers.
TRUSTED_PROXY_PROVIDER=none

# Strict IP enforcement: when 'true', requests without a verifiable client IP are rejected (HTTP 429).
# When 'false', unidentified requests are throttled under an isolated 'unidentified' quota bucket.
STRICT_IP_ENFORCEMENT=false

# ------------------------------------------------------------------------------
# 4. Schema Migration & Fallback Flags (DEVELOPMENT-ONLY)
# ------------------------------------------------------------------------------
# Must remain 'false' in production to preserve fail-closed transactional guarantees.
# Set to 'true' only in local development when transitioning between database migrations.
ALLOW_SCHEMA_FALLBACK=false
